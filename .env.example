# Server Configuration
PORT=5000
NODE_ENV=development
CLIENT_ORIGIN=http://localhost:5173

# MongoDB Connection
MONGO_URI=mongodb://localhost:27017/projaxis
# Set to true if MongoDB is configured as a replica set
MONGO_IS_REPLICA_SET=false

# Authentication & JWT
JWT_SECRET=projaxis_super_secure_jwt_secret_key_2026_dev_mode
JWT_EXPIRES_IN=8h
COOKIE_SECRET=projaxis_cookie_secret_key_2026

# Timezone
TIMEZONE=Asia/Kolkata

# File Upload Settings
UPLOAD_DIR=../uploads
MAX_FILE_SIZE_MB=10

# Default Admin Credentials for Seeding
DEFAULT_ADMIN_EMAIL=admin@projaxis.edu
DEFAULT_ADMIN_PASSWORD=Admin@12345

# SMTP / Email Configuration (Optional - logs to console if empty)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM="ProjAxis Academic Portal" <noreply@projaxis.edu>
