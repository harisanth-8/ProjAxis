# Server Configuration
PORT=5000
NODE_ENV=production
CLIENT_ORIGIN=https://your-projaxis-client.vercel.app

# MongoDB Atlas Connection
MONGO_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/projaxis?retryWrites=true&w=majority
MONGO_IS_REPLICA_SET=false

# Authentication & JWT Secrets
JWT_SECRET=your_super_secret_jwt_key_min_32_characters_here
JWT_EXPIRES_IN=8h
COOKIE_SECRET=your_super_secret_cookie_key_here

# Timezone & Uploads
TIMEZONE=Asia/Kolkata
UPLOAD_DIR=../uploads
MAX_FILE_SIZE_MB=10

# Default Admin Credentials for Seeding
DEFAULT_ADMIN_EMAIL=admin@projaxis.edu
DEFAULT_ADMIN_PASSWORD=Admin@12345

# SMTP / Email Configuration (Optional)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM="ProjAxis Academic Portal" <noreply@projaxis.edu>
